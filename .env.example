# Codify — add ONE free key to unlock 20 RPM / 1000 RPD (free tier). No key = demo + OVH 2 RPM still works.
# The 5-agent team (Architect→Coder→Reviewer→Tester→Fixer) is the foundation; providers are plug-ins.
VITE_OPENROUTER_KEY= # https://openrouter.ai/keys — 17 free models :free, 1k RPD after $10 once (still free use)
VITE_KILO_KEY=       # https://app.kilo.ai/profile — 200 req/hr
VITE_GROQ_KEY=       # https://console.groq.com/keys — 30 RPM
VITE_GEMINI_KEY=     # https://aistudio.google.com/app/apikey — 1M ctx
# No-key plug-ins (default, no signup): OVH 2 RPM (Qwen3.5-397B) + LLM7 turbo + Ollama local — work with empty .env
